# ==================== qos.js ====================
msgid "Control Plus - Network Limit"
msgstr "管控 Plus - 网络限速"

msgid "<b><font color=\"green\">Network Limit: Limit the bandwidth of specific devices based on MAC address.</font></b><br/><span style=\"color:red;\">Note: You must disable \"Software/Hardware Flow Offloading\" in the firewall settings, otherwise the speed limit will not work!</span>"
msgstr "<b><font color=\"green\">网络限速：基于 MAC 地址限制特定设备的带宽。</font></b><br/><span style=\"color:red;\">注意：必须关闭防火墙的“软件/硬件流量分载”，否则限速无效！</span>"

msgid "Speed Limit List"
msgstr "限速列表"

msgid "Download Limit (KB/s)"
msgstr "下载限速 (KB/s)"

msgid "e.g., 1250 (approx. 10Mbps)"
msgstr "例如: 1250 (约10Mbps)"

msgid "Upload Limit (KB/s)"
msgstr "上传限速 (KB/s)"

msgid "e.g., 125"
msgstr "例如: 125"

# ==================== time.js ====================
msgid "Control Plus - Time Limit"
msgstr "管控 Plus - 时间限制"

msgid "<b><font color=\"green\">Use nftables to control data packet filtering to prohibit users who meet the set conditions from connecting to the Internet.</font></b><br/>Time Limit: Restrict whether a specified MAC address machine can access the Internet.<br/>Leaving MAC blank means restricting all machines. Weekdays are represented by 1-7. For multiple days, use custom: 1,5 for Monday and Friday."
msgstr "<b><font color=\"green\">利用 nftables 来管控数据包过滤以禁止符合设定条件的用户连接互联网。</font></b><br/>时间限制: 限制指定MAC地址机器是否联网。<br/>不指定MAC代表限制所有机器，星期用1-7表示，多个日期用自定义：1,5表示星期一和星期五。"

msgid "Control Strength"
msgstr "管控强度"

msgid "Normal: Disconnect.<br/>Strict: Disconnect, and cannot connect to the router backend!"
msgstr "普通管控：断网。<br/>强力管控：断网，且无法连接路由器后台！"

msgid "Normal Control"
msgstr "普通管控"

msgid "Strict Control"
msgstr "强力管控"

msgid "Time Limit List"
msgstr "时间限制列表"

# ==================== weburl.js ====================
msgid "Control Plus - Web URL Filter"
msgstr "管控 Plus - 网址过滤"

msgid "<b><font color=\"green\">Web URL Filter: Intercept via DNS resolution, perfectly supporting HTTPS blocking.</font></b><br/><span style=\"color:red;\">Note: The device must use this router's DNS service for it to take effect.</span><br/>Supports full domain names (e.g., example.com) or wildcards (e.g., *.example.com). <b>Separate multiple domains with commas.</b> Leaving MAC blank means restricting all machines.<br/><span style=\"color:orange;\">⚠ IPv6 fallback: when a MAC is specified, all of its IPv6 80/443 traffic (except LAN/link-local addresses) will be blocked as a safety net, even if the target domain is not in the list.</span>"
msgstr "<b><font color=\"green\">网址过滤：通过 DNS 解析进行拦截，完美支持 HTTPS 封禁。</font></b><br/><span style=\"color:red;\">注意：设备必须使用本路由器的 DNS 服务才能生效。</span><br/>支持完整域名（如 example.com）或通配符（如 *.example.com）。<b>多个域名请用逗号隔开。</b>不指定MAC代表限制所有机器。<br/><span style=\"color:orange;\">⚠ IPv6 兜底机制：当指定了 MAC 时，该设备所有访问外网的 IPv6 80/443 流量（除了局域网/链路本地地址）将被作为安全网拦截，即使目标域名不在列表中。</span>"

msgid "Web URL Filter List"
msgstr "网址过滤列表"

