# ==================== maclist.js ====================
msgid "Control Plus - MAC Access"
msgstr "管控 Plus - 准入控制"

msgid "<b><font color=\"green\">MAC Black/White List: Low-level network access control.</font></b><br/><span style=\"color:red;\">Note: In whitelist mode, devices not in the list will be completely unable to access the Internet.</span>"
msgstr "<b><font color=\"green\">MAC 黑白名单：底层网络级别的访问控制。</font></b><br/><span style=\"color:red;\">注意：白名单模式下，未加入列表的设备将完全无法上网。</span>"

msgid "Access Mode"
msgstr "准入模式"

msgid "Blacklist: Devices in the list are prohibited from accessing the Internet.<br/>Whitelist: Only devices in the list are allowed to access the Internet, all others are blocked!"
msgstr "黑名单：列表内的设备禁止上网。<br/>白名单：仅列表内的设备允许上网，其他全部拦截！"

msgid "Blacklist Mode (Deny Access)"
msgstr "黑名单模式 (禁止访问)"

msgid "Whitelist Mode (Allow Access)"
msgstr "白名单模式 (允许访问)"

msgid "Device List"
msgstr "设备列表"

msgid "MAC Address"
msgstr "MAC地址"

# ==================== protocol.js ====================
msgid "Control Plus - Protocol Filter"
msgstr "管控 Plus - 协议过滤"

msgid "<b><font color=\"green\">Protocol Filter: Control whether a specified MAC machine can use specific protocol ports.</font></b><br/>Ports can be a continuous range separated by a colon, e.g., 5000:5100, or multiple ports separated by commas, e.g., 5100,5110,5001:5002"
msgstr "<b><font color=\"green\">协议过滤：可以控制指定MAC机器是否使用指定协议端口。</font></b><br/>端口可以是连续端口范围用冒号分隔如 5000:5100，或多个端口用逗号分隔如：5100,5110,5001:5002"

msgid "Protocol Filter List"
msgstr "协议过滤列表"

msgid "Current Status"
msgstr "当前状态"

msgid "Checking..."
msgstr "检查中..."

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Enable"
msgstr "启用"

msgid "Remarks"
msgstr "备注"

msgid "MAC Address <font color=\"green\">(Leave blank for all clients)</font>"
msgstr "MAC地址<font color=\"green\">(留空为全部客户端)</font>"

msgid "Port Protocol"
msgstr "端口协议"

msgid "TCP"
msgstr "TCP"
msgid "UDP"
msgstr "UDP"
msgid "ICMP"
msgstr "ICMP"
msgid "TCP + UDP (Both)"
msgstr "TCP + UDP (双协议)"

msgid "Invalid port format. Only numbers, colons, and commas are allowed (no spaces)"
msgstr "端口格式错误，只能输入数字、冒号、逗号（不能有空格）"

msgid "Source Port"
msgstr "源端口"
msgid "e.g., 1024,5000:5100 (blank = any)"
msgstr "例如：1024,5000:5100 (留空=任意)"

msgid "Destination Port"
msgstr "目的端口"
msgid "e.g., 80,443,5000:5100"
msgstr "例如：80,443,5000:5100"

# 注意：这里的 HTML 标签必须完全保留，不能多一个空格或换行
msgid "<span class=\"hide-in-table\"><b>Common ports:</b> 80=HTTP, 443=HTTPS, 22=SSH, 23=Telnet, 3389=RDP, 21=FTP, 25=SMTP, 110=POP3, 143=IMAP, 445=SMB, 53=DNS (TCP/UDP), 853=Encrypted DNS, 1723=PPTP, 20=UDP-FTP, 69=UDP-TFTP, 161=UDP-SNMP, 500=UDP-IPSEC, 1701=UDP-L2TP.</span>"
msgstr "<span class=\"hide-in-table\"><b>常用端口：</b> 80=HTTP, 443=HTTPS, 22=SSH, 23=Telnet, 3389=远程桌面, 21=FTP, 25=邮件, 110=邮件, 143=邮件, 445=局域网共享, 53=域名解析, 853=加密DNS, 1723=VPN, 20=文件传输, 69=简单文件传输, 161=网络管理, 500=VPN, 1701=VPN.</span>"

