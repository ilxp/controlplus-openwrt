msgid "Advanced Settings - Local Black/White List"
msgstr "高级设置 - 本地黑白名单"

msgid "The whitelist has the highest priority and will not be intercepted. Enter one domain per line (supports wildcards like *.baidu.com), starting with # for comments. The global black/white list always takes effect regardless of the time fields above."
msgstr "白名单具有最高优先级，不会被拦截。每行输入一个域名（支持通配符如 *.baidu.com），以 # 开头为注释。全局黑白名单始终生效，不受上方时间字段限制。"

msgid "Global Blacklist (black.list)"
msgstr "全局黑名单 (black.list)"

msgid "Global Whitelist (white.list)"
msgstr "全局白名单 (white.list)"

# ==================== wol.js ====================

msgid "Control Plus - Wake on LAN"
msgstr "管控 Plus - 网络唤醒"

msgid "<b><font color=\"green\">Wake on LAN (WOL): Send a magic packet to wake up a device.</font></b><br/>The device must be connected via Ethernet and have WOL enabled in BIOS/OS."
msgstr "<b><font color=\"green\">网络唤醒 (WOL)：发送魔法包来唤醒设备。</font></b><br/>设备必须通过有线连接，并在 BIOS/系统中开启网络唤醒功能。"

msgid "WOL Device List"
msgstr "唤醒设备列表"

msgid "Interface"
msgstr "发送接口"

msgid "Awake"
msgstr "唤醒"

msgid "Waking up..."
msgstr "正在唤醒..."

msgid "Sending magic packet..."
msgstr "正在发送魔法包..."

msgid "Magic packet sent successfully to "
msgstr "魔法包发送成功："

msgid "Wake up failed"
msgstr "唤醒失败"

msgid "Unknown error"
msgstr "未知错误"

msgid "Close"
msgstr "关闭"

msgid "MAC address is empty!"
msgstr "MAC地址不能为空！"