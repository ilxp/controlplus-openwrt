config basic 'basic'
	option time_enabled '0'
	option proto_enabled '0'
	option weburl_enabled '0'
	option qos_enabled '0'
	option maclist_enabled '0'
	option maclist_mode 'black'
	option control_mode '0'

config time 'config_time'
	option enable '1'
	option remarks 'Example Time Control'
	option timestart '00:00'
	option timeend '23:59'
	option week '*'

config protocol 'config_protocol'
	option enable '1'
	option remarks 'Example Protocol Control'
	option proto 'tcp'
	option portd '80'
	option timestart '00:00'
	option timeend '00:00'
	option week '*'

config weburl 'config_weburl'
	option enable '1'
	option remarks 'Example Weburl Control'
	option timestart '00:00'
	option timeend '00:00'
	option week '*'

config qos 'config_qos'
	option enable '1'
	option remarks 'Example QoS Control'
	option mac ''
	option down ''
	option up ''

config maclist 'mac1'
	option enable '1'
	option remarks 'Kid Device'
	option mac ''